{
    "name": "silverstripe/installer",
    "type": "silverstripe-recipe",
    "description": "The SilverStripe Framework Installer",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.4",
        "silverstripe/recipe-plugin": "*",
        "silverstripe/vendor-plugin": "*",
        "silverstripe/framework": "*",
        "silverstripe/recipe-cms": "*",
        "silverstripe/login-forms": "*",
        "silverstripe/htmleditor-tinymce": "*",
        "dnadesign/silverstripe-elemental": "*",
        "undefinedoffset/sortablegridfield": "*",
        "bummzack/sortablefile": "*",
        "dnadesign/silverstripe-elemental-userforms": "*",
        "undefinedoffset/silverstripe-nocaptcha": "*",
        "silverstripe/spamprotection": "*",
        "wilr/silverstripe-googlesitemaps": "*",
        "innis-maggiore/silverstripe-content-extensions": "*",
        "innis-maggiore/silverstripe-smtp-tester": "*",
        "innis-maggiore/silverstripe-social-meta-tags": "*",
        "twbs/bootstrap": "*",
        "fortawesome/font-awesome": "*",
        "unclecheese/display-logic": "*",
        "silvershop/silverstripe-hasonefield": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "*"
    },
    "scripts": {
        "expose-theme-vendor": [
            "cp -R vendor/twbs/bootstrap/dist themes/whittendav/vendor/bootstrap",
            "cp -R vendor/fortawesome/font-awesome/js-packages/@fortawesome/fontawesome-free themes/whittendav/vendor/fontawesome-free"
        ]
    },
    "extra": {
        "project-files-installed": [
            ".htaccess",
            "app/.htaccess",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ]
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "SirNoah\\Whittendav\\": "app/src/"
        }
    }
}
